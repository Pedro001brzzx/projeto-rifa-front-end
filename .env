# Environment Configuration

# API Base URL
# Configure this with your backend API URL
# Example: http://localhost:5000/api or https://your-api.com/api
# VITE_API_URL=http://localhost:5000

# Development Mode (set to 'true' to bypass login and use mock user)
VITE_DEV_MODE=true

# REACT_APP_API_URL - URL da API backend
REACT_APP_API_URL=http://localhost:5000

